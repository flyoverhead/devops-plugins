{
  "id": "fallback-secrets",
  "title": "Secrets with literal fallbacks",
  "seeds": [
    "(getenv|getEnv|GetEnv|envOr|EnvOr|environ\\.get|config\\.get|settings\\.get|SetDefault)\\([[:space:]]*[\"'][A-Za-z0-9_.]+[\"'][[:space:]]*,[[:space:]]*[\"'][^\"']+[\"']",
    "(process\\.env\\.[A-Za-z0-9_]+|process\\.env\\[[^]]+\\]|getenv\\([^)]*\\)|environ\\.get\\([^)]*\\))[[:space:]]*(\\|\\||\\?\\?|or)[[:space:]]*[\"'][^\"']+[\"']",
    "ENV\\.fetch\\([^,)]+,[[:space:]]*[\"']",
