{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "CodeQL",
          "rules": [
            {"id": "py/sql-injection", "defaultConfiguration": {"level": "error"}, "properties": {"precision": "high", "security-severity": "8.8", "tags": ["security"]}},
            {"id": "py/unused-import", "defaultConfiguration": {"level": "note"}, "properties": {"precision": "very-high", "tags": ["maintainability"]}},
            {"id": "py/clear-text-logging", "defaultConfiguration": {"level": "warning"}, "properties": {"precision": "high", "security-severity": "7.5", "tags": ["security"]}}
          ]
        }
      },
      "results": [
        {"ruleId": "py/sql-injection", "ruleIndex": 0, "message": {"text": "Query built from user input."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/db.py"}, "region": {"startLine": 42}}}]},
        {"ruleId": "py/unused-import", "ruleIndex": 1, "message": {"text": "Import of os is not used."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/db.py"}, "region": {"startLine": 1}}}]},
        {"ruleId": "py/clear-text-logging", "ruleIndex": -1, "message": {"text": "Password written to the log."}, "locations": [{"physicalLocation": {"artifactLocation": {"uri": "app/auth.py"}, "region": {"startLine": 17}}}]}
      ]
    }
  ]
}
