{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command", "timeout": 60, "statusMessage": "Linting OpenAPI specification...", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/lint-openapi.sh\""}
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {"type": "command", "statusMessage": "Detecting API tooling...", "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\""}
        ]
      }
    ]
  }
}
